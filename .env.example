# ==============================================================================
# NimbusFlow AutoPay Recovery Voice Agent (.env.example)
# Copy this file to .env and provide your specific credentials.
# NEVER commit .env to source control.
# ==============================================================================

# Gemini AI API Key (Injected by runtime or configured here)
GEMINI_API_KEY=""

# Base URL of your deployed application or ngrok tunnel (e.g., https://your-subdomain.ngrok-free.app)
# Required for Vapi webhooks, SMS links, and hosted checkout URLs
APP_URL="http://localhost:3000"
PORT=3000

# Vapi Telephony & Voice Agent Provider Integration
# Obtain from your Vapi dashboard (https://dashboard.vapi.ai)
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""
# Model choice configured in your Vapi dashboard (e.g., gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022)
VAPI_LLM_MODEL="gpt-4o-mini"

# Webhook Authentication Secret (Used by Vapi & provider tool endpoints)
# Must be a secure random secret (e.g. generated via `openssl rand -hex 24`)
SHARED_TOOL_SECRET="change-this-to-a-secure-random-32-char-secret"

# Operations & Admin Console Security
# Operators can log in via HTTP Basic Auth or direct 1-click token
OPS_USER="ops"
OPS_PASSWORD="change-this-to-a-secure-ops-password"
ADMIN_TOKEN="change-this-to-a-secure-admin-token-min-32-chars"

# Dialing Safety & Guardrails
# Outbound calls are strictly locked to this comma-separated whitelist of consented test numbers
TEST_PHONE_NUMBERS="+15550100001,+15550100002"
ALLOW_COMPLIANCE_OVERRIDE="false"

# Optional Twilio Integration for Real SMS Delivery
# If omitted or unconfigured, system uses high-fidelity simulated SMS delivery visible in the dashboard
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
